{
  "name": "@59alex/video-streams-react",
  "version": "0.1.0",
  "type": "module",
  "description": "Ready React video attachments: streamed upload, server preparation and HLS playback",
  "license": "MIT",
  "author": "Aleksandr Kashevarov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlorian59/video-streams-react.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "assets",
    "examples"
  ],
  "peerDependencies": {
    "@59alex/video-streams": "^0.1.0",
    "@59alex/file-streams": "^0.1.0",
    "@59alex/file-streams-react": "^0.1.0",
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@59alex/video-streams": "file:../video-streams/browser",
    "@59alex/file-streams": "file:../file-streams/browser",
    "@59alex/file-streams-react": "file:../file-streams-react",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "jsdom": "27.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "npm run build && tsc -p tsconfig.examples.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/package-smoke.mjs",
    "demo:spring": "npm run build && node scripts/spring-demo.mjs",
    "capture:spring": "npm run build && node scripts/capture-spring.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
